# =============================================================================
# Docker Environment Variables - Vollständige Konfiguration
# =============================================================================
# Basierend auf: truck_signs_designs/settings/test_docker.py
#
# WICHTIG: 
# 1. Kopiere diese Datei nach .env
# 2. Fülle die Werte aus
# 3. Füge .env zu .gitignore hinzu!
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core Settings
# -----------------------------------------------------------------------------
DOCKER_SECRET_KEY=dev-secret-key-change-in-production-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ENV=development

# -----------------------------------------------------------------------------
# Database Configuration (für Django Settings)
# -----------------------------------------------------------------------------
DOCKER_DB_HOST=truck-signs-db
DOCKER_DB_PORT=5432
DOCKER_DB_NAME=truck_signs_db
DOCKER_DB_USER=truck_signs_user
DOCKER_DB_PASSWORD=secure_password_123

# -----------------------------------------------------------------------------
# Database Configuration (für entrypoint.sh psql wait script)
# -----------------------------------------------------------------------------
POSTGRES_HOST=truck-signs-db
POSTGRES_PORT=5432
POSTGRES_DB=truck_signs_db
POSTGRES_USER=truck_signs_user
POSTGRES_PASSWORD=secure_password_123

# -----------------------------------------------------------------------------
# Stripe Payment Configuration
# -----------------------------------------------------------------------------
# Hole deine Keys von: https://dashboard.stripe.com/test/apikeys
DOCKER_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_PUBLISHABLE_KEY
DOCKER_STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_SECRET_KEY

# -----------------------------------------------------------------------------
# Email Configuration (Gmail SMTP)
# -----------------------------------------------------------------------------
# Für Gmail: Verwende App-Passwort (nicht dein normales Passwort!)
# Anleitung: https://support.google.com/accounts/answer/185833
DOCKER_EMAIL_HOST_USER=your-email@gmail.com
DOCKER_EMAIL_HOST_PASSWORD=your-gmail-app-password

# =============================================================================
# PRODUCTION WERTE (später ändern!)
# =============================================================================
# Für Production sollten diese Werte geändert werden:
# 
# DOCKER_SECRET_KEY → Zufälliger 50-Zeichen String
# DEBUG → False
# ALLOWED_HOSTS → your-domain.com
# DJANGO_ENV → production
# DOCKER_DB_PASSWORD → Starkes, zufälliges Passwort
# DOCKER_STRIPE_* → Live Keys (pk_live_..., sk_live_...)
# =============================================================================
